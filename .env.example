# Copy to .env and adjust. Every value has a working default; `docker compose up` needs no .env at all.

# --- web ---------------------------------------------------------------------------------------
WEB_PORT=3000
# If set, the UI asks for this key and every API/WebSocket call must present it (recommended on any shared host).
APP_API_KEY=

# --- database ----------------------------------------------------------------------------------
POSTGRES_USER=agent
POSTGRES_PASSWORD=agent
POSTGRES_DB=agent

# --- model (nutboy02/Agents-A1-4B-Kimi-heretic) ---------------------------------------------------
LLM_MODEL=nutboy02/Agents-A1-4B-Kimi-heretic:latest
LLM_BACKEND=ollama
LLM_BASE_URL=http://ollama:11434
# Context window requested from the server. Keep it constant: changing it makes Ollama reload the model.
LLM_NUM_CTX=65536
LLM_KEEP_ALIVE=30m
OLLAMA_NUM_PARALLEL=2
# Max reasoning tokens before the <think> block is closed for the model.
THINKING_BUDGET=1800
# Prompt size (tokens) at which old history is summarised. The model was tuned on short traces.
CONTEXT_BUDGET=28000

# --- agent behaviour ---------------------------------------------------------------------------
MAX_STEPS=40
TEAM_PARALLELISM=2

# --- sandbox (one Docker container + workspace volume per chat session) ------------------------------
SANDBOX_IMAGE=decillion-sandbox:latest
SANDBOX_MEMORY=2g
SANDBOX_CPUS=2
# bridge = internet access for the agent; none = fully offline sandboxes
SANDBOX_NETWORK=bridge
SANDBOX_IDLE_MINUTES=45
# true = also bake Chromium into the sandbox image (+~600 MB) for the Playwright MCP server
SANDBOX_INSTALL_PLAYWRIGHT=false

# --- optional MCP credentials (servers stay hidden in the UI until set) ------------------------------
GITHUB_TOKEN=
BRAVE_API_KEY=

LOG_LEVEL=INFO
